rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Helper Functions
    // ===============================================================
    
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() && 
        (exists(/databases/$(database)/documents/admins/$(request.auth.uid)) || 
         (request.auth.token.email == "river.soldier@gmail.com" && request.auth.token.email_verified == true) ||
         (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
        );
    }

    function isModerator() {
      return isAuthenticated() && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'moderator';
    }

    function isCoach() {
      return isAuthenticated() && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'coach';
    }

    // ===============================================================
    // Rules
    // ===============================================================

    match /test/connection {
      allow read: if true;
    }

    match /system/config {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Legacy collections (keeping for backward compatibility during transition)
    match /admins/{uid} {
      allow read: if isAuthenticated();
      allow write: if isAdmin() || (isAuthenticated() && uid == request.auth.uid && request.auth.token.email == "river.soldier@gmail.com");
    }
    match /moderator_profiles/{profileId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }
    match /schools/{schoolId} {
      allow read: if isAuthenticated();
      allow create, delete: if isAdmin();
      allow update: if isAuthenticated();
    }
    match /battles/{battleId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated();
      allow delete: if isAdmin();
    }

    // New Schema Collections
    match /users/{userId} {
      allow read: if isAuthenticated();
      // Users can update their own profile, admins can update any
      allow write: if isAdmin() || (isAuthenticated() && request.auth.uid == userId);
    }

    match /seasons/{seasonId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /teams/{teamId} {
      allow read: if isAuthenticated();
      allow create, delete: if isAdmin();
      // Coaches can update their own team's roster/progress
      allow update: if isAdmin() || (isCoach() && resource.data.coachId == request.auth.uid);
    }

    match /matches/{matchId} {
      allow read: if isAuthenticated();
      // Admins can create/schedule matches. Moderators can update scores for their assigned matches.
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (isModerator() && resource.data.moderatorId == request.auth.uid) || isAuthenticated(); // Temporarily allow all authenticated users to update matches while refactoring
    }
  }
}
